# Copy to .env and fill in to enable optional live integrations.
# Nothing in this repo requires any of these to run `sdr-toolkit demo`,
# `sdr-toolkit wizard`, or the test suite -- they only unlock live LLM
# calls and CRM activation. The wizard also accepts these as one-off
# form inputs instead, if you'd rather not put a key in a file at all.

# --- LLM providers (pick one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Open-source/local models (Ollama, LM Studio, vLLM, ...) need no key --
# just a reachable base_url, e.g. http://localhost:11434/v1

# --- CRM activation (pick one, or none for CSV / the built-in CRM) ---
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_API_DOMAIN=
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# --- Optional: contact enrichment (fills in missing emails) ---
HUNTER_API_KEY=
