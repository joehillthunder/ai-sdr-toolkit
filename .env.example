# Copy to .env and fill in to enable optional live integrations.
# Nothing in this repo requires any of these to run `sdr-toolkit demo`
# or the test suite -- they only unlock --live mode and CRM activation.

# Required for --live (real Claude calls instead of the offline mock LLM)
ANTHROPIC_API_KEY=

# Optional: enables HubSpotAdapter in sdr_toolkit/integrations.py
HUBSPOT_ACCESS_TOKEN=
